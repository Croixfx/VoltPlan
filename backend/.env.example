# VoltPlan Backend Configuration

# Application
APP_NAME=VoltPlan Backend
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=["*"]

# Database
# For SQLite (default local development without PostgreSQL):
DATABASE_URL=sqlite:///./voltplan.db
# For PostgreSQL (e.g. docker-compose):
# DATABASE_URL=postgresql+psycopg2://voltplan_user:voltplan_password@localhost:5432/voltplan_db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# AI Vision Configuration
# Supported providers: "mock", "gemini", "openai"
AI_PROVIDER=mock
# Gemini API Key & Model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI API Key & Model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Engineering Standards
DEFAULT_STANDARD=RS IEC 60364
