# VoltPlan Backend Configuration

# Application
APP_NAME=VoltPlan Backend
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=["*"]

# Database
# For SQLite (default local development without PostgreSQL):
DATABASE_URL=sqlite:///./voltplan.db
# For PostgreSQL (e.g. docker-compose):
# DATABASE_URL=postgresql+psycopg2://voltplan_user:voltplan_password@localhost:5432/voltplan_db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# AI Vision Configuration
# Supported providers: "mock", "gemini", "openai"
AI_PROVIDER=mock
# Gemini API Key & Model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAI API Key & Model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Access control (set this for ANY deployment reachable from the internet)
# When set, every route except /api/health requires the header  X-API-Key: <value>
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Per-user login. Empty = login off (local development). Production requires it; use a long random string
# that is NOT the API_KEY.
AUTH_SECRET=
# Projects made before accounts existed go to the account with this email when it first signs in.
LEGACY_OWNER_EMAIL=
# Comma-separated administrator emails: they can open every user's projects and deactivate accounts.
ADMIN_EMAILS=

# Engineering Standards
DEFAULT_STANDARD=RS IEC 60364
